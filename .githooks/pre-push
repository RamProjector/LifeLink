#!/usr/bin/env bash
#
# LifeLink pre-push gate.
#
# Runs the same Android checks CI runs, locally, before a push leaves the
# machine — so a broken build, a lint error, a detekt finding, or a failing unit
# test is caught before it reaches a pull request.
#
# Install once per clone:
#   git config core.hooksPath .githooks
# (or run scripts/setup-git-hooks.sh, which does the same thing)
#
# Bypass in an emergency (please do not make a habit of it):
#   git push --no-verify
#
# Environment:
#   LIFELINK_HOOK_STRICT=1   Fail the push when the Android toolchain is missing
#                            instead of skipping the Android checks.
#   LIFELINK_HOOK_SKIP=1     Skip the hook entirely (same as --no-verify).
#   LIFELINK_HOOK_BACKEND=1  Also run the FastAPI backend test suite.

set -uo pipefail

if [[ "${LIFELINK_HOOK_SKIP:-0}" == "1" ]]; then
  echo "[pre-push] LIFELINK_HOOK_SKIP=1 — skipping checks."
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 1

failures=0
ran_any=0

section() { printf '\n\033[1;34m==> %s\033[0m\n' "$1"; }
ok()      { printf '\033[1;32m  ✓ %s\033[0m\n' "$1"; }
bad()     { printf '\033[1;31m  ✗ %s\033[0m\n' "$1"; failures=$((failures + 1)); }
skip()    { printf '\033[1;33m  • %s\033[0m\n' "$1"; }

# ---------------------------------------------------------------------------
# Backend (optional — off by default because it needs a Python venv)
# ---------------------------------------------------------------------------
if [[ "${LIFELINK_HOOK_BACKEND:-0}" == "1" ]]; then
  section "Backend tests (FastAPI)"
  if [[ -x "lifelink_fastapi/.venv/bin/python" ]]; then
    ran_any=1
    if (cd lifelink_fastapi && .venv/bin/python -m pytest -q); then
      ok "backend tests passed"
    else
      bad "backend tests failed"
    fi
  else
    skip "lifelink_fastapi/.venv not found — skipping backend tests"
  fi
fi

# ---------------------------------------------------------------------------
# Android: lint + detekt + spotless + unit tests + debug build
# ---------------------------------------------------------------------------
section "Android checks (lint, detekt, spotless, unit tests, assembleDebug)"

android_dir="LifeLinkAndroid"
gradlew="$android_dir/gradlew"

if [[ ! -x "$gradlew" ]]; then
  bad "LifeLinkAndroid/gradlew is missing or not executable"
else
  # The Android Gradle Plugin needs a JDK and an Android SDK. If either is
  # absent we cannot run the checks; warn loudly rather than pretend they ran.
  have_java=0
  if command -v java >/dev/null 2>&1 || [[ -n "${JAVA_HOME:-}" && -x "${JAVA_HOME}/bin/java" ]]; then
    have_java=1
  fi
  have_sdk=0
  if [[ -n "${ANDROID_HOME:-}" || -n "${ANDROID_SDK_ROOT:-}" || -f "$android_dir/local.properties" ]]; then
    have_sdk=1
  fi

  if [[ "$have_java" == "1" && "$have_sdk" == "1" ]]; then
    ran_any=1
    # `lint` (not `lintDebug`) so both debug and release lint run; detekt and
    # spotlessCheck are the static-analysis/format gates; testDebugUnitTest and
    # assembleDebug prove the app still compiles and its tests pass.
    if (cd "$android_dir" && ./gradlew \
          --no-daemon --stacktrace \
          lint detekt spotlessCheck testDebugUnitTest assembleDebug); then
      ok "Android checks passed"
    else
      bad "Android checks failed — fix the errors above before pushing"
    fi
  else
    msg="Android toolchain not available (java=$have_java, sdk=$have_sdk) — skipping Android checks"
    if [[ "${LIFELINK_HOOK_STRICT:-0}" == "1" ]]; then
      bad "$msg (LIFELINK_HOOK_STRICT=1)"
    else
      skip "$msg; set LIFELINK_HOOK_STRICT=1 to make this fatal"
    fi
  fi
fi

# ---------------------------------------------------------------------------
# Result
# ---------------------------------------------------------------------------
if [[ "$failures" -gt 0 ]]; then
  printf '\n\033[1;31m[pre-push] %d check group(s) failed — push blocked.\033[0m\n' "$failures"
  printf 'Fix the failures above, or bypass with: git push --no-verify\n'
  exit 1
fi

if [[ "$ran_any" == "0" ]]; then
  printf '\n\033[1;33m[pre-push] No checks could run in this environment; allowing push.\033[0m\n'
else
  printf '\n\033[1;32m[pre-push] All checks passed.\033[0m\n'
fi
exit 0
