# EditorConfig for the LifeLink Android module.
#
# ktlint (via Spotless) and Android Studio both read this file, so the
# formatting rules are identical in the editor and in CI.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 140
# Compose @Composable functions are PascalCase by convention.
ktlint_standard_function-naming = disabled
# Compose code frequently uses trailing commas and multi-line argument lists.
ktlint_standard_function-signature = disabled

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
